/* Style of the widgets that the MAXI synoptic panel puts on MAXI_synoptic_v2.svg.
   The panel is made for a fixed window size, so the sizes are in pixels and do not scale. */

/* Value labels. The slots in the SVG are dark and 56 px high. */
PyDMLabel {
    font-size: 30px;
    color: #f2f4f7;
}

/* Date and time, on the slot DATETIME_value */
ClockLabel {
    font-size: 24px;
    color: #a3adb8;
}
